/data/

# Staging secrets (tunnel token + GitHub App creds); only the .example is committed
deploy/staging/.env.staging

# Node / Astro
web/node_modules/
web/dist/
web/.astro/
npm-debug.log*

# Gradle / Ktor
api/.gradle/
api/.kotlin/
api/build/
.gradle/

# OS / editor
.DS_Store
Thumbs.db
.idea/
*.iml

# Design handoff bundle (reference only; large binaries)
.design-handoff/

# Local git worktrees (see using-git-worktree skill)
.worktrees/

# Local planning notes (agent-authored, not for commit)
.plans/
