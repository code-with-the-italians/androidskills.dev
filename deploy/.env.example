# Kamal deployment environment (non-secret values; load with `set -a; source deploy/.env`)
# Kamal secrets are fetched via `kamal secrets` or from your 1Password/vault; do not put them here.

# Host where Kamal deploys both services
KAMAL_HOST=1.2.3.4
KAMAL_SSH_USER=root

# Container registry credentials
KAMAL_REGISTRY_USERNAME=your-registry-username
KAMAL_REGISTRY_PASSWORD=your-registry-password
