---
import BaseLayout from './BaseLayout.astro';
import AdminNav from '../components/AdminNav.astro';
import Toast from '../components/Toast.astro';
import { requireAdmin, type MeResponse } from '../lib/api';

interface Props {
  title: string;
  description?: string;
  me?: MeResponse;
}

const { title, description = 'Admin · androidskills.dev', me: meProp } = Astro.props;

let me = meProp;
if (!me) {
  try {
    me = await requireAdmin(Astro.request);
  } catch {
    return new Response(null, { status: 404 });
  }
}

if (me.role !== 'admin') {
  return new Response(null, { status: 404 });
}

const pathname = Astro.url.pathname;
function navActive(href: string): boolean {
  if (href === '/admin') return pathname === '/admin';
  return pathname.startsWith(href);
}
---

<BaseLayout title={title} description={description} bare={true}>
  <div class="admin-shell">
    <aside class="admin-side" data-admin-side>
      <div class="top">
        <a class="brand" href="/" data-brand-short style="font-size:17px;">
          <b>android</b>skills.dev
        </a>
        <span class="admin-tag">admin</span>
      </div>
      <AdminNav active={navActive} />
    </aside>
    <div class="admin-main">
      <div class="admin-bar">
        <button class="icon-btn admin-menu-btn" data-admin-menu aria-label="Menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M3 6h18M3 12h18M3 18h18" />
          </svg>
        </button>
        <h1>{title}</h1>
        <div class="row" style="margin-left:auto;gap:8px;">
          <button class="icon-btn" data-theme-toggle aria-label="Toggle theme">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" data-theme-icon>
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
            </svg>
          </button>
        </div>
      </div>
      <div class="admin-content">
        <slot />
      </div>
    </div>
  </div>
  <Toast />
</BaseLayout>

<script>
  (function () {
    const menuBtn = document.querySelector('[data-admin-menu]');
    const side = document.querySelector('[data-admin-side]');
    menuBtn?.addEventListener('click', () => {
      side?.classList.toggle('open');
    });
  })();
</script>
