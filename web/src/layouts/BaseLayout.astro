---
import ThemeInit from '../components/ThemeInit.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** When true, suppresses the public header/footer (e.g. admin pages). */
  bare?: boolean;
}

const {
  title,
  description = 'Curated AI coding skills for Android and Kotlin development.',
  bare = false,
} = Astro.props;

const pathname = Astro.url.pathname;
function navActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&family=Spline+Sans+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <ThemeInit />
  </head>
  <body>
    {
      !bare && (
        <header class="site-head">
          <div class="wrap bar">
            <a class="brand" href="/">
              <span class="glyph">A</span>
              <b>android</b>skills.dev
            </a>
            <nav class="nav">
              <a href="/search" aria-current={navActive('/search') ? 'page' : undefined}>Skills</a>
              <a href="/trends" aria-current={navActive('/trends') ? 'page' : undefined}>Trends</a>
              <a href="/timeline" aria-current={navActive('/timeline') ? 'page' : undefined}>Timeline</a>
              <a href="/cli" aria-current={navActive('/cli') ? 'page' : undefined}>CLI</a>
              <a href="/about" aria-current={navActive('/about') ? 'page' : undefined}>About</a>
              <a href="/contact" aria-current={navActive('/contact') ? 'page' : undefined}>Contact</a>
            </nav>
            <div class="head-right">
              <button class="icon-btn hide-sm" data-theme-toggle aria-label="Toggle theme">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" data-theme-icon>
                  <circle cx="12" cy="12" r="4" />
                  <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
                </svg>
              </button>
              <a class="btn btn-sm btn-outline hide-sm" href="/submit">Submit a skill</a>
              <a class="btn btn-sm btn-primary" href="/auth">Sign in</a>
              <button class="icon-btn menu-btn" data-menu-open aria-label="Open menu">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <path d="M3 6h18M3 12h18M3 18h18" />
                </svg>
              </button>
            </div>
          </div>
        </header>
      )
    }

    <slot />

    {
      !bare && (
        <footer class="site-foot">
          <div class="wrap">
            <div class="cols">
              <div>
                <a class="brand" href="/" style="margin-bottom:14px;">
                  <b>android</b>skills.dev
                </a>
                <p class="muted" style="font-size:13.5px;max-width:280px;">
                  The open index of AI coding skills for Android development. Community-curated, maintainer-reviewed.
                </p>
              </div>
              <div>
                <h5>Explore</h5>
                <a href="/search">Browse skills</a>
                <a href="/bundles">Bundles</a>
                <a href="/timeline">Timeline</a>
                <a href="/cli">CLI tool</a>
              </div>
              <div>
                <h5>Contribute</h5>
                <a href="/submit">Submit a skill</a>
                <a href="/auth">Sign in</a>
                <a href="/about">Guidelines</a>
                <a href="/contact">Contact</a>
              </div>
              <div>
                <h5>Project</h5>
                <a href="/about">About</a>
                <a href="https://github.com/code-with-the-italians/androidskills.dev" target="_blank" rel="noopener">GitHub</a>
              </div>
            </div>
            <div class="legal">
              <span>© 2026 androidskills.dev · Not affiliated with Google or the Android Open Source Project</span>
              <span>v0.1.0</span>
            </div>
          </div>
        </footer>
      )
    }

    <!-- Theme toggle script -->
    <script is:inline>
      (function () {
        function getSettings() {
          try {
            return JSON.parse(localStorage.getItem('androidskills') || '{}');
          } catch (e) {
            return {};
          }
        }
        function saveSettings(partial) {
          var s = getSettings();
          Object.assign(s, partial);
          localStorage.setItem('androidskills', JSON.stringify(s));
        }
        function resolvedDark() {
          var s = getSettings();
          if (s.theme === 'dark') return true;
          if (s.theme === 'light') return false;
          return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        }
        function syncToggles() {
          var dark = resolvedDark();
          document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
            btn.setAttribute('aria-pressed', String(dark));
          });
        }
        document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            saveSettings({ theme: resolvedDark() ? 'light' : 'dark' });
            var s = getSettings();
            var r = document.documentElement;
            if (s.theme === 'system') r.removeAttribute('data-theme');
            else r.setAttribute('data-theme', s.theme);
            syncToggles();
          });
        });
        syncToggles();
      })();
    </script>
  </body>
</html>
