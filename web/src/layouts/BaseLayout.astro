---
import ThemeInit from '../components/ThemeInit.astro';
import AuthHeader from '../components/AuthHeader.astro';
import Toast from '../components/Toast.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** When true, suppresses the public header/footer (e.g. admin pages). */
  bare?: boolean;
}

const {
  title,
  description = 'Curated AI coding skills for Android and Kotlin development.',
  bare = false,
} = Astro.props;

const pathname = Astro.url.pathname;
const canonicalUrl = new URL(pathname, Astro.site || Astro.url).toString();

function navActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}

const pageTitle = title === 'androidskills.dev' ? title : `${title} · androidskills.dev`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <ThemeInit />
  </head>
  <body>
    {
      !bare && (
        <>
          <a href="#main" class="skip-link">
            Skip to content
          </a>
          <header class="site-head">
            <div class="wrap bar">
              <a class="brand" href="/">
                <span class="glyph">A</span>
                <b>android</b>skills.dev
              </a>
              <nav class="nav" aria-label="Primary">
                <a href="/search" aria-current={navActive('/search') ? 'page' : undefined}>Skills</a>
                <a href="/trends" aria-current={navActive('/trends') ? 'page' : undefined}>Trends</a>
                <a href="/timeline" aria-current={navActive('/timeline') ? 'page' : undefined}>Timeline</a>
                <a href="/cli" aria-current={navActive('/cli') ? 'page' : undefined}>CLI</a>
                <a href="/about" aria-current={navActive('/about') ? 'page' : undefined}>About</a>
                <a href="/contact" aria-current={navActive('/contact') ? 'page' : undefined}>Contact</a>
              </nav>
              <div class="head-right">
                <button class="icon-btn hide-sm" data-theme-toggle aria-label="Toggle theme">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" data-theme-icon>
                    <circle cx="12" cy="12" r="4" />
                    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
                  </svg>
                </button>
                <a class="btn btn-sm btn-outline hide-sm" href="/submit">Submit a skill</a>
                <AuthHeader />
                <button class="icon-btn menu-btn" data-menu-open aria-label="Open menu">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M3 6h18M3 12h18M3 18h18" />
                  </svg>
                </button>
              </div>
            </div>
          </header>
        </>
      )
    }

    <main id="main">
      <slot />
    </main>

    {
      !bare && (
        <>
          <footer class="site-foot">
            <div class="wrap">
              <div class="cols">
                <div>
                  <a class="brand" href="/" style="margin-bottom:14px;">
                    <b>android</b>skills.dev
                  </a>
                  <p class="muted" style="font-size:13.5px;max-width:280px;">
                    The open index of AI coding skills for Android development. Community-curated, maintainer-reviewed.
                  </p>
                </div>
                <div>
                  <h5>Explore</h5>
                  <a href="/search">Browse skills</a>
                  <a href="/bundles">Bundles</a>
                  <a href="/timeline">Timeline</a>
                  <a href="/cli">CLI tool</a>
                </div>
                <div>
                  <h5>Contribute</h5>
                  <a href="/submit">Submit a skill</a>
                  <a href="/signin">Sign in</a>
                  <a href="/about">Guidelines</a>
                  <a href="/contact">Contact</a>
                </div>
                <div>
                  <h5>Project</h5>
                  <a href="/about">About</a>
                  <a href="https://github.com/code-with-the-italians/androidskills.dev" target="_blank" rel="noopener">GitHub</a>
                </div>
              </div>
              <div class="legal">
                <span>© 2026 androidskills.dev · Not affiliated with Google or the Android Open Source Project</span>
                <span>v0.1.0</span>
              </div>
            </div>
          </footer>

          <div class="drawer-backdrop" aria-hidden="true"></div>
          <div class="drawer-panel" role="dialog" aria-label="Menu" aria-modal="true">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
              <a class="brand" href="/">
                <b>android</b>skills.dev
              </a>
              <button class="icon-btn close" data-menu-close aria-label="Close menu">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <path d="M18 6L6 18M6 6l12 12" />
                </svg>
              </button>
            </div>
            <nav aria-label="Mobile">
              <a href="/search">Skills</a>
              <a href="/trends">Trends</a>
              <a href="/timeline">Timeline</a>
              <a href="/cli">CLI</a>
              <a href="/about">About</a>
              <a href="/contact">Contact</a>
              <a href="/submit">Submit a skill</a>
              <a href="/signin">Sign in</a>
            </nav>
            <div style="margin-top:auto;border-top:1px solid var(--border);padding-top:12px;display:flex;flex-direction:column;gap:8px;">
              <label style="font-size:13px;color:var(--text-dim);">
                Theme
                <select data-tweak="theme" class="select" style="width:100%;margin-top:4px;">
                  <option value="system">System</option>
                  <option value="light">Light</option>
                  <option value="dark">Dark</option>
                </select>
              </label>
              <label style="font-size:13px;color:var(--text-dim);">
                Accent
                <select data-tweak="accent" class="select" style="width:100%;margin-top:4px;">
                  <option value="green">Green</option>
                  <option value="indigo">Indigo</option>
                  <option value="orange">Orange</option>
                  <option value="mono">Mono</option>
                </select>
              </label>
              <label style="font-size:13px;color:var(--text-dim);">
                Density
                <select data-tweak="density" class="select" style="width:100%;margin-top:4px;">
                  <option value="regular">Regular</option>
                  <option value="compact">Compact</option>
                  <option value="comfy">Comfy</option>
                </select>
              </label>
            </div>
          </div>

          <Toast />
        </>
      )
    }

    <!-- Theme / accent / density script -->
    <script is:inline>
      (function () {
        function getSettings() {
          try {
            return JSON.parse(localStorage.getItem('androidskills') || '{}');
          } catch (e) {
            return {};
          }
        }
        function saveSettings(partial) {
          var s = getSettings();
          Object.assign(s, partial);
          localStorage.setItem('androidskills', JSON.stringify(s));
          applySettings();
        }
        function applySettings() {
          var s = getSettings();
          var r = document.documentElement;
          if (s.theme && s.theme !== 'system') r.setAttribute('data-theme', s.theme);
          else r.removeAttribute('data-theme');
          if (s.accent && s.accent !== 'green') r.setAttribute('data-accent', s.accent);
          else r.removeAttribute('data-accent');
          if (s.density && s.density !== 'regular') r.setAttribute('data-density', s.density);
          else r.removeAttribute('data-density');
        }
        function resolvedDark() {
          var s = getSettings();
          if (s.theme === 'dark') return true;
          if (s.theme === 'light') return false;
          return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        }
        function syncToggles() {
          var dark = resolvedDark();
          document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
            btn.setAttribute('aria-pressed', String(dark));
          });
        }
        document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            saveSettings({ theme: resolvedDark() ? 'light' : 'dark' });
            syncToggles();
          });
        });
        document.addEventListener('prefs:apply', function () {
          syncToggles();
          applySettings();
        });
        syncToggles();
        applySettings();
      })();
    </script>

    <!-- Drawer and tweaks (only on public pages) -->
    {
      !bare && (
        <script src="../scripts/drawer.ts"></script>
        <script src="../scripts/tweaks.ts"></script>
      )
    }
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -40px;
    left: 12px;
    z-index: 1000;
    padding: 8px 12px;
    background: var(--accent-text);
    color: var(--accent-ink);
    border-radius: var(--r-md);
    font-weight: 600;
    font-size: 13px;
    transition: top var(--t-micro) var(--e-standard);
  }
  .skip-link:focus {
    top: 12px;
  }
</style>
