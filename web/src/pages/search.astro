---
import BaseLayout from '../layouts/BaseLayout.astro';
import SkillCard from '../components/SkillCard.astro';
import EmptyState from '../components/EmptyState.astro';
import ErrorState from '../components/ErrorState.astro';
import { createApiClient, type SkillSearchPage, type CategoryWithCount } from '../lib/api';

const api = createApiClient(Astro.request);

const url = Astro.url;
const params = url.searchParams;

const q = params.get('q') ?? undefined;
const cats = params.getAll('cat');
const tags = params.getAll('tag');
const size = params.get('size') ?? undefined;
const sort = params.get('sort') ?? 'relevance';
const verified = params.get('verified');
const page = parseInt(params.get('page') ?? '1', 10);

let searchResult: SkillSearchPage | null = null;
let categories: CategoryWithCount[] = [];
let error = false;

try {
  [searchResult, categories] = await Promise.all([
    api.searchSkills({ q, cat: cats, tag: tags, size, sort, page, verified: verified !== 'false' }),
    api.getCategories(),
  ]);
} catch (e) {
  error = true;
}

const items = searchResult?.items ?? [];
const total = searchResult?.total ?? 0;
const totalPages = searchResult?.totalPages ?? 0;

function removeFilter(key: string, value: string) {
  const qs = new URLSearchParams(params);
  const values = qs.getAll(key).filter((v) => v !== value);
  qs.delete(key);
  values.forEach((v) => qs.append(key, v));
  return `/search?${qs.toString()}`;
}

const activeFilters = [
  ...cats.map((c) => ({ label: categories.find((cat) => cat.slug === c)?.name ?? c, href: removeFilter('cat', c) })),
  ...tags.map((t) => ({ label: `#${t}`, href: removeFilter('tag', t) })),
  ...(size ? [{ label: size, href: removeFilter('size', size) }] : []),
  ...(verified === 'false' ? [{ label: 'Include unverified', href: removeFilter('verified', 'false') }] : []),
];
---

<BaseLayout title={q ? `${q} — Search` : 'Search'} description="Find AI coding skills for Android and Kotlin development.">
  <section class="section" style="padding-top:32px;">
    <div class="wrap">
      <!-- Search bar -->
      <form action="/search" method="get" role="search" style="margin-bottom:24px;">
        <div class="search">
          <svg class="ic-search" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" />
          </svg>
          <input type="text" name="q" value={q ?? ''} placeholder="Search skills…" autocomplete="off" aria-label="Search skills" />
        </div>
      </form>

      <div style="display:grid;grid-template-columns:220px 1fr;gap:32px;align-items:start;">
        <!-- Filters sidebar -->
        <aside class="filters" aria-label="Filters">
          {activeFilters.length > 0 ? (
            <div style="margin-bottom:12px;display:flex;flex-wrap:wrap;gap:6px;">
              {activeFilters.map((f) => (
                <a class="chip on" href={f.href}>
                  {f.label}
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12" /></svg>
                </a>
              ))}
              <a href="/search" class="btn btn-sm btn-ghost">Clear all</a>
            </div>
          ) : null}

          <div class="filter-grp">
            <h4>Sort</h4>
            <div class="seg" aria-label="Sort">
              {['relevance', 'installs', 'updated', 'tokens'].map((s) => (
                <a
                  href={`/search?${new URLSearchParams({ ...Object.fromEntries(params), sort: s }).toString()}`}
                  aria-current={sort === s ? 'page' : undefined}
                >
                  {s}
                </a>
              ))}
            </div>
          </div>

          {categories.length > 0 && (
            <div class="filter-grp">
              <h4>Categories</h4>
              {categories.map((cat) => {
                const active = cats.includes(cat.slug);
                const newCats = active ? cats.filter((c) => c !== cat.slug) : [...cats, cat.slug];
                const qs = new URLSearchParams({ ...Object.fromEntries(params.entries()) });
                qs.delete('cat');
                newCats.forEach((c) => qs.append('cat', c));
                return (
                  <a class="check" href={`/search?${qs.toString()}`}>
                    <span class="box" style={active ? 'background:var(--accent);border-color:var(--accent);' : ''}>
                      {active && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>}
                    </span>
                    {cat.name}
                    <span class="ct">{cat.count}</span>
                  </a>
                );
              })}
            </div>
          )}

          <div class="filter-grp">
            <h4>Token size</h4>
            {['<2k', '2-5k', '5k+'].map((s) => {
              const active = size === s;
              const qs = new URLSearchParams({ ...Object.fromEntries(params.entries()) });
              if (active) qs.delete('size'); else qs.set('size', s);
              return (
                <a class="check" href={`/search?${qs.toString()}`}>
                  <span class="box" style={active ? 'background:var(--accent);border-color:var(--accent);' : ''}>
                    {active && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>}
                  </span>
                  {s}
                </a>
              );
            })}
          </div>
        </aside>

        <!-- Results -->
        <div>
          {error && (
            <ErrorState title="Couldn’t load results" body="Filters are still available, but the results list failed." />
          )}

          {!error && total > 0 && (
            <div class="between" style="margin-bottom:16px;">
              <span class="muted" style="font-size:13.5px;">
                {total} skill{total !== 1 ? 's' : ''}
                {q && <> for “<strong>{q}</strong>”</>}
              </span>
            </div>
          )}

          {!error && items.length > 0 && (
            <div class="grid grid-skills">
              {items.map((skill) => (
                <SkillCard skill={skill} />
              ))}
            </div>
          )}

          {!error && items.length === 0 && (
            <EmptyState
              title={q ? `No skills match “${q}”` : 'No skills found'}
              body={q ? 'Try removing a filter or searching a broader term.' : 'Try adjusting your filters or search query.'}
            >
              <a slot="action" class="btn btn-sm btn-outline" href="/search">Clear filters</a>
              {categories.length > 0 && (
                <div slot="action" style="margin-top:12px;display:flex;flex-wrap:wrap;gap:6px;justify-content:center;">
                  {categories.slice(0, 3).map((cat) => (
                    <a class="chip" href={`/search?cat=${encodeURIComponent(cat.slug)}`}>{cat.name}</a>
                  ))}
                </div>
              )}
            </EmptyState>
          )}

          {/* Pagination */}
          {!error && totalPages > 1 && (
            <div style="display:flex;justify-content:center;margin-top:32px;">
              <div class="pager">
                {page > 1 && (
                  <a href={`/search?${new URLSearchParams({ ...Object.fromEntries(params), page: String(page - 1) }).toString()}`}>←</a>
                )}
                <span class="cur">{page}</span>
                <span class="faint">/ {totalPages}</span>
                {page < totalPages && (
                  <a href={`/search?${new URLSearchParams({ ...Object.fromEntries(params), page: String(page + 1) }).toString()}`}>→</a>
                )}
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
