---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmptyState from '../components/EmptyState.astro';
---

<BaseLayout title="404" description="Page not found — androidskills.dev" canonical="/404">
  <section class="section" style="min-height:60vh;display:flex;align-items:center;justify-content:center;">
    <div style="max-width:420px;width:100%;">
      <EmptyState title="That page isn’t here" body="It may have been unlisted or the URL is wrong.">
        <a slot="action" class="btn btn-sm btn-primary" href="/search">Search the index</a>
      </EmptyState>

      <form action="/search" method="get" role="search" style="margin-top:24px;">
        <div class="search">
          <svg class="ic-search" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" />
          </svg>
          <input type="text" name="q" placeholder="Search skills…" autocomplete="off" aria-label="Search skills" />
        </div>
      </form>
    </div>
  </section>
</BaseLayout>
