---
import AdminLayout from '../../layouts/AdminLayout.astro';
import EmptyState from '../../components/EmptyState.astro';
import ErrorState from '../../components/ErrorState.astro';
import { requireAdmin } from '../../lib/api';
import { createAdminApiClient } from '../../lib/admin-api';

const me = await requireAdmin(Astro.request).catch(() => null);
if (!me) return new Response(null, { status: 404 });

const api = createAdminApiClient(Astro.request);

let categories: Awaited<ReturnType<typeof api.getCategories>> | null = null;
let error = false;
try {
  categories = await api.getCategories();
} catch (e) {
  error = true;
}

const items = categories ?? [];
---

<AdminLayout title="Categories" me={me}>
  <div class="between" style="margin-bottom: 16px; flex-wrap: wrap; gap: 12px;">
    <div class="callout info" style="font-size: 13px; align-items: flex-start; max-width: 640px;">
      <svg class="ci" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M12 16v-4M12 8h.01" stroke-linecap="round"></path>
      </svg>
      <div>Renaming or merging a category re-tags every skill in it.</div>
    </div>
    <button class="btn btn-sm btn-primary" data-modal-open="#addCat">Add category</button>
  </div>

  {error && (
    <ErrorState title="Couldn’t load categories" body="The categories table failed to load." />
  )}

  {!error && (
    <div class="tbl-wrap">
      <div class="scroll">
        <table class="tbl">
          <thead>
            <tr>
              <th scope="col">Category</th>
              <th scope="col">Slug</th>
              <th scope="col"></th>
            </tr>
          </thead>
          <tbody>
            {items.length === 0 ? (
              <tr>
                <td colspan="3">
                  <EmptyState title="No categories" body="Create a category to start organizing skills." />
                </td>
              </tr>
            ) : (
              items.map((cat) => (
                <tr data-category-slug={cat.slug}>
                  <td>
                    <div class="row" style="gap: 10px;">
                      <span style="font-weight: 600;">{cat.name}</span>
                    </div>
                  </td>
                  <td class="slug" style="font-size: 12.5px;">{cat.slug}</td>
                  <td>
                    <button class="btn btn-sm btn-outline" data-rename={cat.slug} data-name={cat.name}>Rename</button>
                    <button class="btn btn-sm btn-danger" data-delete={cat.slug}>Merge</button>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>
  )}

  <div class="scrim" id="addCat" style="display: none;">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="addCatTitle" style="max-width: 440px;">
      <div class="mhd">
        <b id="addCatTitle" style="font-size: 16px;">Add a category</b>
        <button class="icon-btn" data-modal-close aria-label="Close">×</button>
      </div>
      <div class="mbd stack" style="gap: 14px;">
        <div class="field">
          <label for="ncName">Name</label>
          <input class="input" id="ncName" placeholder="e.g. Background Work" autocomplete="off">
        </div>
        <div class="field">
          <label for="ncSlug">Slug</label>
          <input class="input" id="ncSlug" placeholder="background-work" style="font-family: var(--mono); font-size: 13px;" autocomplete="off">
        </div>
      </div>
      <div class="mft">
        <button class="btn btn-ghost" data-modal-close>Cancel</button>
        <button class="btn btn-primary" data-add-cat>Add category</button>
      </div>
    </div>
  </div>

  <div class="scrim" id="renameCat" style="display: none;">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="renameCatTitle" style="max-width: 440px;">
      <div class="mhd">
        <b id="renameCatTitle" style="font-size: 16px;">Rename category</b>
        <button class="icon-btn" data-modal-close aria-label="Close">×</button>
      </div>
      <div class="mbd stack" style="gap: 14px;">
        <input type="hidden" id="rcOldSlug">
        <div class="field">
          <label for="rcName">New name</label>
          <input class="input" id="rcName" placeholder="New name" autocomplete="off">
        </div>
        <div class="field">
          <label for="rcSlug">New slug</label>
          <input class="input" id="rcSlug" placeholder="new-slug" style="font-family: var(--mono); font-size: 13px;" autocomplete="off">
        </div>
      </div>
      <div class="mft">
        <button class="btn btn-ghost" data-modal-close>Cancel</button>
        <button class="btn btn-primary" data-rename-cat>Save</button>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { createFocusTrap } from '../../scripts/focus-trap';
  import { showToast, showError } from '../../scripts/toast';

  function initModal(scrimSelector: string) {
    const scrim = document.querySelector(scrimSelector) as HTMLElement;
    if (!scrim) return;
    const modal = scrim.querySelector('.modal') as HTMLElement | null;
    const closeBtns = scrim.querySelectorAll('[data-modal-close]');
    let trigger: HTMLElement | null = null;
    let trap: ReturnType<typeof createFocusTrap> | null = null;
    if (modal) trap = createFocusTrap(modal);

    function open(openTrigger?: HTMLElement | null) {
      trigger = openTrigger ?? null;
      scrim.style.display = 'flex';
      document.body.style.overflow = 'hidden';
      trap?.activate();
    }

    function close() {
      scrim.style.display = 'none';
      document.body.style.overflow = '';
      trap?.deactivate(trigger !== null);
    }

    document.querySelectorAll(`[data-modal-open="${scrimSelector}"]`).forEach((btn) => {
      btn.addEventListener('click', () => open(btn as HTMLElement));
    });

    closeBtns.forEach((btn) => btn.addEventListener('click', close));

    scrim.addEventListener('click', (e) => {
      if (e.target === scrim) close();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && scrim.style.display === 'flex') close();
    });
  }

  initModal('#addCat');
  initModal('#renameCat');

  document.querySelector('[data-add-cat]')?.addEventListener('click', async () => {
    const name = (document.getElementById('ncName') as HTMLInputElement | null)?.value;
    const slug = (document.getElementById('ncSlug') as HTMLInputElement | null)?.value;
    if (!name || !slug) return;
    try {
      const res = await fetch(`/api/admin/categories?slug=${encodeURIComponent(slug)}&name=${encodeURIComponent(name)}`, { method: 'POST' });
      if (!res.ok) throw new Error(await res.text());
      showToast('Category added');
      window.location.reload();
    } catch (e) {
      const msg = e instanceof Error ? e.message : 'Failed to add category';
      showError(msg);
    }
  });

  document.querySelectorAll('[data-rename]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const slug = btn.getAttribute('data-rename')!;
      const name = btn.getAttribute('data-name') || '';
      (document.getElementById('rcOldSlug') as HTMLInputElement | null)!.value = slug;
      (document.getElementById('rcName') as HTMLInputElement | null)!.value = name;
      (document.getElementById('rcSlug') as HTMLInputElement | null)!.value = slug;
      const scrim = document.getElementById('renameCat');
      if (scrim) scrim.style.display = 'flex';
    });
  });

  document.querySelector('[data-rename-cat]')?.addEventListener('click', async () => {
    const oldSlug = (document.getElementById('rcOldSlug') as HTMLInputElement | null)?.value;
    const name = (document.getElementById('rcName') as HTMLInputElement | null)?.value;
    const slug = (document.getElementById('rcSlug') as HTMLInputElement | null)?.value;
    if (!oldSlug) return;
    const body: Record<string, string | null> = {};
    if (name) body.name = name;
    if (slug) body.slug = slug;
    try {
      const res = await fetch(`/api/admin/categories/${encodeURIComponent(oldSlug)}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      if (!res.ok) throw new Error(await res.text());
      showToast('Category renamed');
      window.location.reload();
    } catch (e) {
      const msg = e instanceof Error ? e.message : 'Failed to rename category';
      showError(msg);
    }
  });

  document.querySelectorAll('[data-delete]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const from = btn.getAttribute('data-delete')!;
      const to = prompt(`Merge category "${from}" into which slug?`);
      if (!to) return;
      try {
        const res = await fetch(`/api/admin/categories/${encodeURIComponent(from)}/merge?to=${encodeURIComponent(to)}`, { method: 'POST' });
        if (!res.ok) throw new Error(await res.text());
        showToast('Categories merged');
        window.location.reload();
      } catch (e) {
        const msg = e instanceof Error ? e.message : 'Failed to merge categories';
        showError(msg);
      }
    });
  });
</script>
