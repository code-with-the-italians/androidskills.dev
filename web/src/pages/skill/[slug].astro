---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StarButton from '../../components/StarButton.astro';
import { createApiClient, type SkillDetail, type FileTreeResponse, type VersionsResponse } from '../../lib/api';
import { renderMarkdown } from '../../lib/markdown';

const slug = Astro.params.slug!;
const api = createApiClient(Astro.request);

let skill: SkillDetail | null = null;
let files: FileTreeResponse | null = null;
let versions: VersionsResponse | null = null;
let anonymous = true;
let starred = false;

try {
  [skill, files, versions] = await Promise.all([
    api.getSkill(slug),
    api.getSkillFiles(slug),
    api.getSkillVersions(slug),
  ]);
  try {
    const stars = await api.getStars();
    anonymous = false;
    starred = stars.some((s) => s.slug === slug);
  } catch {
    anonymous = true;
  }
} catch (e) {
  return Astro.redirect('/404');
}

const readmeHtml = skill.readmeMd ? await renderMarkdown(skill.readmeMd, { shiftHeadings: true }) : '';
const fileTree = files?.tree ?? [];
---

<BaseLayout title={skill.name} description={skill.description}>
  <section class="section" style="padding-top:32px;">
    <div class="wrap">
      <!-- Breadcrumb -->
      <div class="crumb" style="margin-bottom:20px;">
        <a href="/search">Skills</a>
        <span class="sep">/</span>
        <span>{skill.slug}</span>
      </div>

      <!-- Header -->
      <div style="display:flex;gap:20px;align-items:flex-start;margin-bottom:32px;">
        <div class="skill-ico" style="width:56px;height:56px;border-radius:var(--r-lg);">
          {skill.name.split(/\s+/).slice(0, 2).map((w) => w[0]).join('').toUpperCase()}
        </div>
        <div style="flex:1;min-width:0;">
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
            <h1 style="font-size:30px;letter-spacing:-.02em;">{skill.name}</h1>
            {skill.verified && <span class="badge ok">Verified</span>}
            {skill.featured && <span class="badge info">Featured</span>}
          </div>
          <p class="muted" style="margin-top:6px;">{skill.slug} · v{skill.version}</p>
          <p style="margin-top:10px;max-width:600px;color:var(--text-dim);">{skill.description}</p>

          {!skill.verified && (
            <div class="callout warn" role="alert" style="margin-top:16px;">
              <svg class="ci" viewBox="0 0 24 24" fill="none" stroke="var(--warn)" stroke-width="2" stroke-linecap="round">
                <path d="M10.3 3.9 2.4 18a2 2 0 0 0 1.7 3h15.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0zM12 9v4M12 17h.01" />
              </svg>
              <div style="font-size:12.5px;">
                Not yet maintainer-reviewed. Inspect the source before adding it to an autonomous agent.
                <button class="btn btn-ghost" data-report style="padding:0;color:var(--warn);font-weight:600;" type="button">Report</button>
              </div>
            </div>
          )}

          <!-- Meta -->
          <div style="display:flex;gap:20px;margin-top:16px;flex-wrap:wrap;font-family:var(--mono);font-size:12.5px;color:var(--text-faint);">
            <span>{skill.installs.toLocaleString()} installs</span>
            <span>· {skill.tokenUpfront + skill.tokenOndemand} tokens ({skill.tokenBand})</span>
            <span>· {skill.fileCount} files</span>
            {skill.license && <span>· {skill.license}</span>}
            <span>· by <a href={`/u/${skill.author.handle}`} style="color:var(--accent-text);">{skill.author.handle}</a></span>
          </div>

          <!-- Tags -->
          {skill.tags.length > 0 && (
            <div class="tags" style="margin-top:12px;">
              {skill.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          )}

          <!-- Actions -->
          <div class="row" style="gap:10px;margin-top:20px;">
            <a class="btn btn-primary" href={`/api/skills/${slug}/download`}>
              <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
              Download .zip
            </a>
            <button class="btn btn-outline" data-copy-cmd type="button">
              <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              Copy command
            </button>
            <StarButton slug={slug} anonymous={anonymous} starred={starred} size="md" />
          </div>
        </div>
      </div>

      <div style="display:grid;grid-template-columns:1fr 320px;gap:32px;align-items:start;">
        <!-- README -->
        <div class="card">
          <div class="prose" set:html={readmeHtml} />
        </div>

        <!-- Sidebar: file tree + versions -->
        <aside class="stack">
          {fileTree.length > 0 && (
            <div class="card" style="padding:0;overflow:hidden;" role="region" aria-label="File tree">
              <div style="padding:14px 18px;border-bottom:1px solid var(--border);">
                <h4 style="font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--text-faint);">Files</h4>
              </div>
              <div style="padding:8px;" role="list">
                {fileTree.map((node) => (
                  node.type === 'file' ? (
                    <a
                      href={`/skill/${slug}/files/${node.path}`}
                      class="file-row"
                      role="listitem"
                      aria-label={`File ${node.name} (${node.size} bytes)`}
                    >
                      <span class="nm">{node.name}</span>
                      <span class="sz">{node.size}B</span>
                    </a>
                  ) : (
                    <span class="file-row" role="listitem" style="font-weight:600;" aria-label={`Directory ${node.name}`}>
                      <span class="nm">{node.name}</span>
                    </span>
                  )
                ))}
              </div>
            </div>
          )}

          {versions && versions.versions.length > 0 && (
            <div class="card">
              <h4 style="font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--text-faint);margin-bottom:12px;">Versions</h4>
              {versions.versions.map((v) => (
                <div style="display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid var(--border);">
                  <span style="font-family:var(--mono);font-size:13px;font-weight:600;">v{v.version}</span>
                  {v.current && <span class="badge ok" style="font-size:10px;">Current</span>}
                  <span class="faint" style="font-size:11.5px;margin-left:auto;">{new Date(v.createdAt).toLocaleDateString()}</span>
                </div>
              ))}
            </div>
          )}
        </aside>
      </div>
    </div>
  </section>

  <script>
    import { showToast, showError } from '../../scripts/toast';

    document.querySelector('[data-report]')?.addEventListener('click', async () => {
      const reason = prompt('Why are you reporting this skill?');
      if (!reason) return;
      try {
        const res = await fetch(`/api/skills/${location.pathname.split('/').pop()}/report`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ reason }),
        });
        if (!res.ok) throw new Error(await res.text());
        showToast('Reported');
      } catch (e) {
        showError(e instanceof Error ? e.message : 'Report failed');
      }
    });

    document.querySelector('[data-copy-cmd]')?.addEventListener('click', async () => {
      const slug = location.pathname.split('/').pop();
      const cmd = `androidskills add ${slug}`;
      await navigator.clipboard.writeText(cmd);
      showToast('Command copied');
    });
  </script>
</BaseLayout>
