---
import BaseLayout from '../layouts/BaseLayout.astro';
import SkillCard from '../components/SkillCard.astro';
import EmptyState from '../components/EmptyState.astro';
import { createApiClient } from '../lib/api';

const api = createApiClient(Astro.request);

let stars: Awaited<ReturnType<typeof api.getStars>> | null = null;
let anonymous = false;

try {
  stars = await api.getStars();
} catch {
  anonymous = true;
}
---

<BaseLayout title="Starred skills" description="Your personal library of starred Android skills.">
  <section class="section" style="padding-top:32px;">
    <div class="wrap" style="max-width:440px;">
      <div class="kicker"><span class="tick">//</span> LIBRARY</div>
      <h1 style="font-size:30px;margin-top:8px;">Starred skills</h1>

      {anonymous ? (
        <div style="margin-top:24px;">
          <EmptyState title="Sign in to see your stars" body="Your starred skills are saved to your account.">
            <a slot="action" class="btn btn-primary" href="/signin">Sign in</a>
          </EmptyState>
        </div>
      ) : stars && stars.length > 0 ? (
        <div class="grid grid-skills" style="margin-top:24px;">
          {stars.map((skill) => <SkillCard skill={skill} />)}
        </div>
      ) : (
        <div style="margin-top:24px;">
          <EmptyState title="Nothing starred yet" body="Your starred skills are saved on this device.">
            <a slot="action" class="btn btn-primary" href="/search">Browse skills</a>
          </EmptyState>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
