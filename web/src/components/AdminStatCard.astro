---
export interface Props {
  label: string;
  value: number;
  accent?: 'neutral' | 'warn' | 'danger' | 'accent';
}

const { label, value, accent = 'accent' } = Astro.props;
const colorClass =
  accent === 'warn' ? 'warn' : accent === 'danger' ? 'danger' : accent === 'accent' ? 'accent-text' : 'text';
---

<div class="card" style="padding: 18px;">
  <div class="stat">
    <span class="n" style={`color: var(--${colorClass});`}>{value}</span>
    <span class="l">{label}</span>
  </div>
</div>
