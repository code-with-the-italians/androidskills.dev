---
/**
 * Theme + density + accent persistence.
 * Runs inline in <head> before paint to prevent flash of wrong theme.
 * Matches the design-handoff prototype's localStorage pattern.
 */
---
<script is:inline>
  (function () {
    try {
      var s = JSON.parse(localStorage.getItem('androidskills') || '{}');
      var r = document.documentElement;
      if (s.theme && s.theme !== 'system') r.setAttribute('data-theme', s.theme);
      if (s.accent && s.accent !== 'green') r.setAttribute('data-accent', s.accent);
      if (s.density && s.density !== 'regular') r.setAttribute('data-density', s.density);
    } catch (e) {}
  })();
</script>
