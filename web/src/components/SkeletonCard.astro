---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`card skill-card skeleton-card ${className}`} aria-hidden="true">
  <div class="top">
    <div class="skill-ico" style="background:var(--surface-2);color:transparent;">XX</div>
    <div style="flex:1;min-width:0;display:flex;flex-direction:column;gap:8px;">
      <div class="skeleton" style="height:16px;width:70%;"></div>
      <div class="skeleton" style="height:10px;width:45%;"></div>
    </div>
  </div>
  <div class="skeleton" style="height:12px;width:92%;margin-top:6px;"></div>
  <div class="skeleton" style="height:12px;width:60%;"></div>
  <div class="pillbar" style="margin-top:auto;gap:8px;">
    <div class="skeleton" style="height:24px;width:56px;border-radius:999px;"></div>
    <div class="skeleton" style="height:24px;width:64px;border-radius:999px;"></div>
  </div>
</div>

<style>
  .skeleton-card {
    pointer-events: none;
  }
  .skeleton-card .top {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .skeleton-card .skill-ico {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    font-size: 14px;
    font-weight: 700;
  }
  .skeleton-card .pillbar {
    display: flex;
    flex-wrap: wrap;
  }
</style>
