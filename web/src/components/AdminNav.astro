---
export interface Props {
  active: (href: string) => boolean;
}

const { active } = Astro.props;

const links = [
  { href: '/admin', label: 'Dashboard', icon: 'M3 7h18M3 12h18M3 17h18' },
  { href: '/admin/queue', label: 'Review queue', icon: 'M9 11l3 3 8-8M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11' },
  { href: '/admin/skills', label: 'Skills', icon: 'M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z' },
  { href: '/admin/users', label: 'Users', icon: 'M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75' },
  { href: '/admin/categories', label: 'Categories', icon: 'M3 7h18M3 12h18M3 17h18' },
  { href: '/admin/audit', label: 'Audit log', icon: 'M12 20h9M12 20V4m0 0h9M12 4H3m0 0v16' },
  { href: '/admin/settings', label: 'Settings', icon: 'M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1' },
];
---

<nav class="admin-nav">
  {
    links.map((link) => (
      <a href={link.href} aria-current={active(link.href) ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d={link.icon} />
        </svg>
        {link.label}
      </a>
    ))
  }
  <div class="gap" />
  <a href="/">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M19 12H5M11 6l-6 6 6 6" />
    </svg>
    Back to site
  </a>
</nav>
